# ==============================================================================
# MediDesk Deployment Environment Variables
# Copy to .env and configure for your deployment target
# ==============================================================================

# 1. Flask & Runtime Settings
FLASK_APP=src/app.py
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# 2. Cryptographic & Session Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secure-64-character-string

# 3. HTTPS / TLS Cookie Security
# Set to 'True' if deploying behind HTTPS / TLS (Render, Railway, Cloudflare, etc.)
SESSION_COOKIE_SECURE=True

# 4. Database Persistence
# Absolute path or relative path to SQLite database file
DATABASE_PATH=src/database/medidesk.db
